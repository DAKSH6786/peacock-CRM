# Application
APP_NAME=Peacock One
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WEB_URL=http://localhost:3000
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: leave unset so the web app uses same-origin /backend rewrite
# NEXT_PUBLIC_API_URL=http://localhost:8000
# API_PROXY_TARGET=http://127.0.0.1:8000

# Security — replace in every non-local environment
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Database (PostgreSQL + pgvector)
POSTGRES_USER=peacock
POSTGRES_PASSWORD=peacock
POSTGRES_DB=peacock_one
DATABASE_URL=postgresql+psycopg://peacock:peacock@localhost:5432/peacock_one

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
JOB_BACKEND=celery

# Auth providers (prepared — leave empty locally)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# LLM providers — NEVER hardcode; adapters read from env
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
DEEPSEEK_API_KEY=
LLM_DEFAULT_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Publishing connectors — NEVER hardcode; the "manual" connector needs none of these
# and is always available. WordPress creates drafts only, even when approved.
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
WEBFLOW_API_TOKEN=
WEBFLOW_COLLECTION_ID=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_TOKEN=

# Seed
SEED_ADMIN_EMAIL=admin@peacock.one
SEED_ADMIN_PASSWORD=ChangeMeNow!123
SEED_ORG_NAME=Digital Peacock
SEED_ORG_SLUG=digital-peacock
