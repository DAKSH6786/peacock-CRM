# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://peacock:peacock@localhost:5432/peacock_one?schema=public

# Auth.js / NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
AUTH_URL=http://localhost:3000
# Optional alias used by some tooling
NEXTAUTH_URL=http://localhost:3000

# S3-compatible object storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=peacock-one
S3_ACCESS_KEY_ID=peacock
S3_SECRET_ACCESS_KEY=peacocksecret
S3_FORCE_PATH_STYLE=true

# Email (optional in local development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@digitalpeacock.local

# Background jobs
JOBS_ENABLED=true

# Seed credentials (used only by prisma/seed.ts)
SEED_ADMIN_EMAIL=admin@digitalpeacock.local
SEED_ADMIN_PASSWORD=ChangeMeNow!123
