// ─── Shared platform models ──────────────────────────────────────────────────

model FileAttachment {
  id             String    @id @default(cuid())
  organizationId String
  storageKey     String
  fileName       String
  contentType    String?
  sizeBytes      Int?
  checksum       String?
  uploadedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  uploadedBy   User?        @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([storageKey])
  @@map("file_attachments")
}

model Comment {
  id             String    @id @default(cuid())
  organizationId String
  entityType     String
  entityId       String
  body           String    @db.Text
  authorId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  author   User?     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  mentions Mention[]

  @@index([organizationId, entityType, entityId])
  @@map("comments")
}

model Mention {
  id             String   @id @default(cuid())
  organizationId String
  commentId      String
  mentionedUserId String
  createdAt      DateTime @default(now())

  comment       Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser User    @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([commentId, mentionedUserId])
  @@map("mentions")
}

model ActivityFeed {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  entityType     String
  entityId       String?
  action         String
  summary        String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_feeds")
}

model ApprovalRequest {
  id             String         @id @default(cuid())
  organizationId String
  entityType     String
  entityId       String
  title          String
  status         ApprovalStatus @default(PENDING)
  requestedById  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  steps        ApprovalStep[]
  actions      ApprovalAction[]

  @@index([organizationId, status])
  @@index([entityType, entityId])
  @@map("approval_requests")
}

model ApprovalStep {
  id             String         @id @default(cuid())
  organizationId String
  requestId      String
  stepOrder      Int
  approverRole   String?
  approverUserId String?
  status         ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, stepOrder])
  @@map("approval_steps")
}

model ApprovalAction {
  id             String         @id @default(cuid())
  organizationId String
  requestId      String
  actorId        String?
  status         ApprovalStatus
  comment        String?
  createdAt      DateTime       @default(now())

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@map("approval_actions")
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  title          String
  body           String?
  entityType     String?
  entityId       String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

model SavedView {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  module         String
  name           String
  filters        Json
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, module])
  @@map("saved_views")
}

model CustomFieldDefinition {
  id             String    @id @default(cuid())
  organizationId String
  entityType     String
  key            String
  label          String
  fieldType      String
  options        Json?
  isRequired     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  values       CustomFieldValue[]

  @@unique([organizationId, entityType, key])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id             String   @id @default(cuid())
  organizationId String
  definitionId   String
  entityType     String
  entityId       String
  valueText      String?
  valueNumber    Decimal? @db.Decimal(18, 4)
  valueJson      Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, entityId])
  @@index([organizationId, entityType, entityId])
  @@map("custom_field_values")
}

model ImportJob {
  id               String    @id @default(cuid())
  organizationId   String
  /// Entity key: employees | leads | contacts | clients | deals | attendance | revenue_attribution | projects | invoices | payments | expenses | vendors
  entityType       String
  status           String    @default("QUEUED")
  fileName         String?
  storageKey       String?
  fileAttachmentId String?
  totalRows        Int       @default(0)
  successRows      Int       @default(0)
  failedRows       Int       @default(0)
  skippedRows      Int       @default(0)
  columnMapping    Json?
  previewRows      Json?
  validationErrors Json?
  errorReport      Json?
  errorFileKey     String?
  /// SKIP | UPDATE | FAIL
  duplicatePolicy  String    @default("SKIP")
  /// COMMIT_VALID | ALL_OR_NOTHING
  partialPolicy    String    @default("COMMIT_VALID")
  createdById      String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("ImportJobCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, entityType, createdAt])
  @@map("import_jobs")
}

model ExportJob {
  id               String    @id @default(cuid())
  organizationId   String
  /// tables | reports | employees | crm | projects | invoices | finance | xyme
  exportType       String
  status           String    @default("QUEUED")
  filters          Json?
  columns          String[]  @default([])
  dateFrom         DateTime?
  dateTo           DateTime?
  rowCount         Int?
  fileUrl          String?
  storageKey       String?
  fileAttachmentId String?
  expiresAt        DateTime?
  requiresApproval Boolean   @default(false)
  approvedAt       DateTime?
  approvedById     String?
  rejectionReason  String?
  createdById      String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("ExportJobCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy   User?        @relation("ExportJobApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, exportType, createdAt])
  @@map("export_jobs")
}

model WebhookEndpoint {
  id              String            @id @default(cuid())
  organizationId  String
  name            String
  url             String
  /// SHA-256 hash of signing secret — plaintext shown once at creation
  secretHash      String
  events          String[]
  isActive        Boolean           @default(true)
  failureCount    Int               @default(0)
  lastDeliveredAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deliveries   WebhookDelivery[]

  @@index([organizationId, isActive])
  @@map("webhook_endpoints")
}

/// Stores references/metadata only — never raw secrets in plaintext in app logs
model IntegrationCredentialReference {
  id             String    @id @default(cuid())
  organizationId String
  provider       String
  label          String
  vaultRef       String
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, provider, label])
  @@map("integration_credential_references")
}

model ScheduledJob {
  id             String    @id @default(cuid())
  organizationId String?
  name           String
  jobType        String
  cronExpression String?
  payload        Json?
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([nextRunAt, isActive])
  @@map("scheduled_jobs")
}

model SystemSetting {
  id             String   @id @default(cuid())
  organizationId String?
  key            String
  value          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("system_settings")
}
