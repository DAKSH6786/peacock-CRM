// ─── Finance / invoicing ─────────────────────────────────────────────────────

model Currency {
  id             String   @id @default(cuid())
  organizationId String
  code           String   @db.Char(3)
  name           String
  symbol         String?
  decimalPlaces  Int      @default(2)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@map("currencies")
}

model ExchangeRate {
  id             String   @id @default(cuid())
  organizationId String
  baseCode       String   @db.Char(3)
  quoteCode      String   @db.Char(3)
  rate           Decimal  @db.Decimal(18, 8)
  effectiveAt    DateTime @db.Date
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, baseCode, quoteCode, effectiveAt])
  @@map("exchange_rates")
}

model TaxRate {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String
  /// Basis points or percentage stored as decimal, e.g. 18.00
  ratePercent    Decimal   @db.Decimal(8, 4)
  jurisdiction   String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@map("tax_rates")
}

model Quote {
  id             String    @id @default(cuid())
  organizationId String
  draftNumber    String?
  quoteNumber    String?
  companyId      String?
  dealId         String?
  projectId      String?
  currencyCode   String    @default("INR") @db.Char(3)
  issueDate      DateTime? @db.Date
  validUntil     DateTime? @db.Date
  subtotalMinor  Int       @default(0)
  taxTotalMinor  Int       @default(0)
  totalMinor     Int       @default(0)
  status         String    @default("DRAFT")
  terms          String?   @db.Text
  notes          String?   @db.Text
  internalNotes  String?   @db.Text
  billingAddress Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdById    String?
  updatedById    String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company      ClientCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal         Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items        QuoteItem[]
  versions     QuoteVersion[]
  invoices     Invoice[]

  @@unique([organizationId, quoteNumber])
  @@index([organizationId, status])
  @@index([deletedAt])
  @@map("quotes")
}

model QuoteItem {
  id             String @id @default(cuid())
  organizationId String
  quoteId        String
  description    String
  quantity       Decimal @db.Decimal(18, 4)
  unitPriceMinor Int
  discountMinor  Int     @default(0)
  taxRatePercent Decimal? @db.Decimal(8, 4)
  taxMinor       Int     @default(0)
  lineTotalMinor Int     @default(0)
  sortOrder      Int     @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_items")
}

model QuoteVersion {
  id             String   @id @default(cuid())
  organizationId String
  quoteId        String
  version        Int
  snapshot       Json
  createdById    String?
  createdAt      DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, version])
  @@map("quote_versions")
}

model Invoice {
  id             String    @id @default(cuid())
  organizationId String
  draftNumber    String?
  invoiceNumber  String?
  companyId      String?
  projectId      String?
  dealId         String?
  quoteId        String?
  issueDate      DateTime? @db.Date
  dueDate        DateTime? @db.Date
  currencyCode   String    @default("INR") @db.Char(3)
  subtotalMinor  Int       @default(0)
  taxTotalMinor  Int       @default(0)
  totalMinor     Int       @default(0)
  amountPaidMinor Int      @default(0)
  balanceMinor   Int       @default(0)
  status         String    @default("DRAFT")
  terms          String?   @db.Text
  notes          String?   @db.Text
  internalNotes  String?   @db.Text
  taxIdentifiers Json?
  placeOfSupply  String?
  billingAddress Json?
  pdfFileId      String?
  paymentLinkPlaceholder String?
  recurringTemplateId String?
  reminderConfig Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdById    String?
  updatedById    String?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company      ClientCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal         Deal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)
  quote        Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  statusHistory InvoiceStatusHistory[]
  allocations  PaymentAllocation[]
  reminders    PaymentReminder[]
  creditNotes  CreditNote[]
  revenueAttributions EmployeeRevenueAttribution[]
  financialAttachments FinancialAttachment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, companyId])
  @@index([deletedAt])
  @@map("invoices")
}

model InvoiceItem {
  id             String  @id @default(cuid())
  organizationId String
  invoiceId      String
  description    String
  quantity       Decimal @db.Decimal(18, 4)
  unitPriceMinor Int
  discountMinor  Int     @default(0)
  taxRatePercent Decimal? @db.Decimal(8, 4)
  taxMinor       Int     @default(0)
  lineTotalMinor Int     @default(0)
  sortOrder      Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model InvoiceStatusHistory {
  id             String   @id @default(cuid())
  organizationId String
  invoiceId      String
  fromStatus     String?
  toStatus       String
  changedById    String?
  note           String?
  createdAt      DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, createdAt])
  @@map("invoice_status_history")
}

model CreditNote {
  id             String   @id @default(cuid())
  organizationId String
  invoiceId      String?
  creditNumber   String?
  amountMinor    Int
  currencyCode   String   @default("INR") @db.Char(3)
  reason         String?
  issuedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([organizationId, creditNumber])
  @@map("credit_notes")
}

model Payment {
  id             String   @id @default(cuid())
  organizationId String
  paymentNumber  String?
  amountMinor    Int
  currencyCode   String   @default("INR") @db.Char(3)
  method         String?
  reference      String?
  receivedAt     DateTime @default(now())
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  createdById    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  allocations  PaymentAllocation[]
  revenueAttributions EmployeeRevenueAttribution[]

  @@unique([organizationId, paymentNumber])
  @@index([organizationId, receivedAt])
  @@map("payments")
}

model PaymentAllocation {
  id             String   @id @default(cuid())
  organizationId String
  paymentId      String
  invoiceId      String
  amountMinor    Int
  createdAt      DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

model PaymentReminder {
  id             String   @id @default(cuid())
  organizationId String
  invoiceId      String
  scheduledFor   DateTime
  sentAt         DateTime?
  channel        String?
  status         String   @default("SCHEDULED")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, scheduledFor])
  @@map("payment_reminders")
}

model RecurringInvoiceTemplate {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  companyId      String?
  cadence        String
  nextRunAt      DateTime?
  isActive       Boolean   @default(true)
  template       Json
  reminderConfig Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, nextRunAt])
  @@map("recurring_invoice_templates")
}

model ExpenseCategory {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  expenses     Expense[]

  @@unique([organizationId, code])
  @@map("expense_categories")
}

model Expense {
  id             String         @id @default(cuid())
  organizationId String
  categoryId     String?
  vendorId       String?
  title          String
  amountMinor    Int
  currencyCode   String         @default("INR") @db.Char(3)
  spentAt        DateTime?      @db.Date
  status         ApprovalStatus @default(PENDING)
  notes          String?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category     ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vendor       Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  approvals    ExpenseApproval[]

  @@index([organizationId, status])
  @@map("expenses")
}

model ExpenseApproval {
  id             String         @id @default(cuid())
  organizationId String
  expenseId      String
  approverId     String?
  status         ApprovalStatus @default(PENDING)
  comment        String?
  decidedAt      DateTime?
  createdAt      DateTime       @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@map("expense_approvals")
}

model Vendor {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String?
  email          String?
  phone          String?
  taxIdentifier  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contacts     VendorContact[]
  expenses     Expense[]
  purchaseOrders PurchaseOrder[]
  bills        VendorBill[]
  payments     VendorPayment[]

  @@index([organizationId, name])
  @@map("vendors")
}

model VendorContact {
  id             String   @id @default(cuid())
  organizationId String
  vendorId       String
  name           String
  email          String?
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_contacts")
}

model PurchaseOrder {
  id             String    @id @default(cuid())
  organizationId String
  vendorId       String
  poNumber       String?
  status         String    @default("DRAFT")
  currencyCode   String    @default("INR") @db.Char(3)
  totalMinor     Int       @default(0)
  orderedAt      DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  items        PurchaseOrderItem[]
  bills        VendorBill[]

  @@unique([organizationId, poNumber])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id             String  @id @default(cuid())
  purchaseOrderId String
  description    String
  quantity       Decimal @db.Decimal(18, 4)
  unitPriceMinor Int
  lineTotalMinor Int

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model VendorBill {
  id             String    @id @default(cuid())
  organizationId String
  vendorId       String
  purchaseOrderId String?
  billNumber     String?
  amountMinor    Int
  currencyCode   String    @default("INR") @db.Char(3)
  dueDate        DateTime? @db.Date
  status         String    @default("OPEN")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vendor        Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  payments      VendorPayment[]

  @@index([organizationId, status])
  @@map("vendor_bills")
}

model VendorPayment {
  id             String   @id @default(cuid())
  organizationId String
  vendorId       String
  billId         String?
  amountMinor    Int
  currencyCode   String   @default("INR") @db.Char(3)
  paidAt         DateTime @default(now())
  reference      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  bill         VendorBill?  @relation(fields: [billId], references: [id], onDelete: SetNull)

  @@index([organizationId, paidAt])
  @@map("vendor_payments")
}

model FinancialAttachment {
  id             String   @id @default(cuid())
  organizationId String
  invoiceId      String?
  fileAttachmentId String
  label          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("financial_attachments")
}
