// ─── Company / department progress + XYME ────────────────────────────────────

model Objective {
  id               String         @id @default(cuid())
  organizationId   String
  title            String
  description      String?        @db.Text
  /// COMPANY | DEPARTMENT | TEAM | INDIVIDUAL
  scope            OwnershipScope @default(COMPANY)
  parentId         String?
  departmentId     String?
  teamId           String?
  primaryOwnerId   String?
  financialYearId  String?
  /// e.g. Q1, Q2, H1, FY
  quarter          String?
  startDate        DateTime?      @db.Date
  dueDate          DateTime?      @db.Date
  priority         Priority       @default(MEDIUM)
  status           ProgressStatus @default(NOT_STARTED)
  health           HealthStatus   @default(GREY)
  healthOverridden Boolean        @default(false)
  healthOverrideReason String?
  progressPct      Int            @default(0)
  /// ORGANIZATION | DEPARTMENT | TEAM | PRIVATE
  visibility       String         @default("ORGANIZATION")
  tags             String[]       @default([])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  createdById      String?
  updatedById      String?

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent        Objective?       @relation("ObjectiveAlignment", fields: [parentId], references: [id], onDelete: SetNull)
  children      Objective[]      @relation("ObjectiveAlignment")
  department    Department?      @relation("ObjectiveDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  team          Team?            @relation("ObjectiveTeam", fields: [teamId], references: [id], onDelete: SetNull)
  primaryOwner  User?            @relation("ObjectivePrimaryOwner", fields: [primaryOwnerId], references: [id], onDelete: SetNull)
  financialYear FinancialYear?   @relation(fields: [financialYearId], references: [id], onDelete: SetNull)
  keyResults    KeyResult[]
  owners        ObjectiveOwner[]
  updates       ObjectiveUpdate[]
  initiatives   Initiative[]
  milestones    Milestone[]
  progressUpdates ProgressUpdate[]

  @@index([organizationId, scope, status])
  @@index([organizationId, parentId])
  @@index([organizationId, health])
  @@index([deletedAt])
  @@map("objectives")
}

model KeyResult {
  id               String         @id @default(cuid())
  organizationId   String
  objectiveId      String
  title            String
  metricType       MetricType     @default(NUMBER)
  baseline         Decimal?       @db.Decimal(18, 4)
  target           Decimal?       @db.Decimal(18, 4)
  currentValue     Decimal?       @db.Decimal(18, 4)
  unit             String?
  progressPct      Int            @default(0)
  status           ProgressStatus @default(NOT_STARTED)
  ownerUserId      String?
  /// WEEKLY | MONTHLY | QUARTERLY | AD_HOC
  updateFrequency  String         @default("WEEKLY")
  confidenceScore  Int?
  dueDate          DateTime?      @db.Date
  evidence         String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  objective Objective          @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  owner     User?              @relation("KeyResultOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  updates   KeyResultUpdate[]
  comments  KeyResultComment[]

  @@index([objectiveId])
  @@index([organizationId])
  @@map("key_results")
}

/// Append-only progress history — never silently overwrite
model KeyResultUpdate {
  id             String   @id @default(cuid())
  organizationId String
  keyResultId    String
  previousValue  Decimal? @db.Decimal(18, 4)
  newValue       Decimal  @db.Decimal(18, 4)
  previousProgressPct Int?
  progressPct    Int?
  confidenceScore Int?
  note           String?  @db.Text
  evidence       String?  @db.Text
  createdById    String?
  createdAt      DateTime @default(now())

  keyResult KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("KeyResultUpdateAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([keyResultId, createdAt])
  @@index([organizationId])
  @@map("key_result_updates")
}

model KeyResultComment {
  id             String   @id @default(cuid())
  organizationId String
  keyResultId    String
  body           String   @db.Text
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  keyResult KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("KeyResultCommentAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([keyResultId, createdAt])
  @@map("key_result_comments")
}

model ObjectiveOwner {
  id             String         @id @default(cuid())
  organizationId String
  objectiveId    String
  userId         String?
  employeeId     String?
  scope          OwnershipScope @default(INDIVIDUAL)
  /// OWNER | CONTRIBUTOR
  role           String         @default("OWNER")
  createdAt      DateTime       @default(now())

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee  Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([objectiveId])
  @@index([organizationId])
  @@map("objective_owners")
}

model ObjectiveUpdate {
  id             String   @id @default(cuid())
  organizationId String
  objectiveId    String
  body           String   @db.Text
  progressPct    Int?
  createdById    String?
  createdAt      DateTime @default(now())

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@index([objectiveId, createdAt])
  @@map("objective_updates")
}

/// Structured weekly/monthly progress check-ins
model ProgressUpdate {
  id             String   @id @default(cuid())
  organizationId String
  objectiveId    String?
  /// WEEKLY | MONTHLY
  cadence        String   @default("WEEKLY")
  periodStart    DateTime @db.Date
  periodEnd      DateTime @db.Date
  body           String   @db.Text
  progressPct    Int?
  confidenceScore Int?
  health         HealthStatus?
  riskFlag       Boolean  @default(false)
  blocker        String?  @db.Text
  evidence       String?  @db.Text
  /// DRAFT | SUBMITTED | REVIEWED
  reviewStatus   String   @default("SUBMITTED")
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  objective  Objective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("ProgressUpdateAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy User?      @relation("ProgressUpdateReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, cadence, periodStart])
  @@index([objectiveId, createdAt])
  @@map("progress_updates")
}

model KPI {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  code           String
  description    String?
  metricType     MetricType @default(NUMBER)
  unit           String?
  /// Optional department binding for scorecards
  departmentId   String?
  category       String?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department   Department?  @relation("DepartmentKpis", fields: [departmentId], references: [id], onDelete: SetNull)
  values       KPIValue[]
  scorecardLinks ScorecardKpi[]

  @@unique([organizationId, code])
  @@index([organizationId, departmentId])
  @@map("kpis")
}

model KPIValue {
  id             String   @id @default(cuid())
  organizationId String
  kpiId          String
  periodStart    DateTime @db.Date
  periodEnd      DateTime @db.Date
  value          Decimal  @db.Decimal(18, 4)
  createdAt      DateTime @default(now())
  createdById    String?

  kpi KPI @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([kpiId, periodStart, periodEnd])
  @@index([organizationId])
  @@map("kpi_values")
}

model CompanyTarget {
  id             String   @id @default(cuid())
  organizationId String
  financialYearId String
  name           String
  metricCode     String
  targetMinor    Int?
  targetValue    Decimal? @db.Decimal(18, 4)
  currencyCode   String?  @db.Char(3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  financialYear FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Restrict)

  @@index([organizationId, financialYearId])
  @@map("company_targets")
}

model DepartmentTarget {
  id             String   @id @default(cuid())
  organizationId String
  financialYearId String
  departmentId   String
  name           String
  metricCode     String
  targetMinor    Int?
  targetValue    Decimal? @db.Decimal(18, 4)
  currencyCode   String?  @db.Char(3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  financialYear FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  department    Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([organizationId, departmentId])
  @@map("department_targets")
}

model Milestone {
  id             String         @id @default(cuid())
  organizationId String
  objectiveId    String?
  title          String
  dueDate        DateTime?      @db.Date
  status         ProgressStatus @default(NOT_STARTED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  objective    Objective?   @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@index([organizationId, dueDate])
  @@map("milestones")
}

model Initiative {
  id             String         @id @default(cuid())
  organizationId String
  objectiveId    String?
  title          String
  description    String?        @db.Text
  status         ProgressStatus @default(NOT_STARTED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  objective    Objective?   @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("initiatives")
}

model BusinessReview {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  /// MONTHLY | QUARTERLY
  reviewType     String   @default("MONTHLY")
  periodStart    DateTime @db.Date
  periodEnd      DateTime @db.Date
  summary        String?  @db.Text
  majorWins      String?  @db.Text
  missedTargets  String?  @db.Text
  /// Frozen snapshot JSON of KPI/objective values at review time
  snapshot       Json?
  heldAt         DateTime?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?                @relation("BusinessReviewAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  items        BusinessReviewItem[]

  @@index([organizationId, periodStart])
  @@index([organizationId, reviewType])
  @@map("business_reviews")
}

model BusinessReviewItem {
  id             String    @id @default(cuid())
  organizationId String
  reviewId       String
  /// WIN | MISS | RISK | DECISION | ACTION
  itemType       String
  title          String
  body           String?   @db.Text
  ownerUserId    String?
  dueDate        DateTime? @db.Date
  status         String    @default("OPEN")
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  review BusinessReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  owner  User?          @relation("BusinessReviewItemOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([reviewId, itemType])
  @@map("business_review_items")
}

/// Configurable department scorecards with selected KPIs
model DepartmentScorecard {
  id             String    @id @default(cuid())
  organizationId String
  departmentId   String
  name           String
  description    String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department   Department    @relation("DepartmentScorecards", fields: [departmentId], references: [id], onDelete: Cascade)
  kpis         ScorecardKpi[]

  @@unique([organizationId, departmentId, name])
  @@index([organizationId, departmentId])
  @@map("department_scorecards")
}

model ScorecardKpi {
  id           String @id @default(cuid())
  scorecardId  String
  kpiId        String
  sortOrder    Int    @default(0)
  /// Optional target override for this scorecard context
  targetValue  Decimal? @db.Decimal(18, 4)

  scorecard DepartmentScorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  kpi       KPI                 @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([scorecardId, kpiId])
  @@map("scorecard_kpis")
}

/// Configurable health calculation rules
model ProgressHealthRule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// GREEN | AMBER | RED | GREY
  health         HealthStatus
  /// JSON match: { minProgress?, maxProgress?, maxDaysOverdue?, requireUpdates?, statuses? }
  match          Json
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, isActive])
  @@map("progress_health_rules")
}

model RiskRegister {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  description    String?  @db.Text
  likelihood     Int?
  impact         Int?
  status         String   @default("OPEN")
  ownerUserId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  updates      RiskUpdate[]

  @@index([organizationId, status])
  @@map("risk_register")
}

model RiskUpdate {
  id             String   @id @default(cuid())
  organizationId String
  riskId         String
  body           String   @db.Text
  createdById    String?
  createdAt      DateTime @default(now())

  risk RiskRegister @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@index([riskId, createdAt])
  @@map("risk_updates")
}

model Issue {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  description    String?  @db.Text
  status         String   @default("OPEN")
  priority       Priority @default(MEDIUM)
  ownerUserId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@map("issues")
}

model DecisionLog {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  decision       String   @db.Text
  decidedAt      DateTime @default(now())
  decidedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, decidedAt])
  @@map("decision_logs")
}

// ─── XYME ────────────────────────────────────────────────────────────────────

model XYMECycle {
  id             String   @id @default(cuid())
  organizationId String
  financialYearId String
  /// Quarter number 1-4 within the financial year
  quarter        Int
  name           String
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  isActive       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  financialYear FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  plans         XYMEPlan[]
  weightConfig  XYMEWeightConfiguration?

  @@unique([organizationId, financialYearId, quarter])
  @@index([organizationId, isActive])
  @@map("xyme_cycles")
}

model XYMEWeightConfiguration {
  id             String   @id @default(cuid())
  organizationId String
  cycleId        String   @unique
  weightX        Int      @default(50)
  weightY        Int      @default(30)
  weightME       Int      @default(20)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cycle XYMECycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@map("xyme_weight_configurations")
}

model XYMEPlan {
  id             String         @id @default(cuid())
  organizationId String
  cycleId        String
  employeeId     String
  userId         String?
  status         ApprovalStatus @default(DRAFT)
  submittedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  cycle        XYMECycle    @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  user         User?        @relation("XYMEPlanEmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  goals        XYMEGoal[]
  approvals    XYMEApproval[]
  checkIns     XYMECheckIn[]
  scores       XYMEScore[]

  @@unique([cycleId, employeeId])
  @@index([organizationId, status])
  @@map("xyme_plans")
}

model XYMEGoal {
  id             String         @id @default(cuid())
  organizationId String
  planId         String
  title          String
  description    String?        @db.Text
  category       XYMECategory
  weight         Int            @default(0)
  metricType     MetricType     @default(NUMBER)
  baseline       Decimal?       @db.Decimal(18, 4)
  target         Decimal?       @db.Decimal(18, 4)
  currentValue   Decimal?       @db.Decimal(18, 4)
  unit           String?
  startDate      DateTime?      @db.Date
  dueDate        DateTime?      @db.Date
  priority       Priority       @default(MEDIUM)
  status         ProgressStatus @default(NOT_STARTED)
  progressPct    Int            @default(0)
  approvalStatus ApprovalStatus @default(DRAFT)
  approvalDate   DateTime?
  completionDate DateTime?
  finalScore     Decimal?       @db.Decimal(8, 2)
  managerComments String?       @db.Text
  employeeComments String?      @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  plan      XYMEPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  updates   XYMEGoalUpdate[]
  evidence  XYMEEvidence[]
  comments  XYMEComment[]

  @@index([planId, category])
  @@index([organizationId, status])
  @@map("xyme_goals")
}

model XYMEGoalUpdate {
  id             String   @id @default(cuid())
  organizationId String
  goalId         String
  currentValue   Decimal? @db.Decimal(18, 4)
  progressPct    Int?
  note           String?  @db.Text
  createdById    String?
  createdAt      DateTime @default(now())

  goal XYMEGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
  @@map("xyme_goal_updates")
}

model XYMEApproval {
  id             String         @id @default(cuid())
  organizationId String
  planId         String
  status         ApprovalStatus @default(PENDING)
  reviewerId     String?
  comment        String?        @db.Text
  decidedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  plan XYMEPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, status])
  @@map("xyme_approvals")
}

model XYMECheckIn {
  id             String   @id @default(cuid())
  organizationId String
  planId         String
  note           String?  @db.Text
  progressPct    Int?
  checkedInAt    DateTime @default(now())
  createdById    String?
  createdAt      DateTime @default(now())

  plan XYMEPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, checkedInAt])
  @@map("xyme_check_ins")
}

model XYMEEvidence {
  id             String   @id @default(cuid())
  organizationId String
  goalId         String
  title          String
  description    String?  @db.Text
  fileAttachmentId String?
  url            String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  goal XYMEGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("xyme_evidence")
}

model XYMEComment {
  id             String   @id @default(cuid())
  organizationId String
  goalId         String
  body           String   @db.Text
  authorId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  goal XYMEGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
  @@map("xyme_comments")
}

model XYMEScore {
  id             String   @id @default(cuid())
  organizationId String
  planId         String
  scoreX         Decimal? @db.Decimal(8, 2)
  scoreY         Decimal? @db.Decimal(8, 2)
  scoreME        Decimal? @db.Decimal(8, 2)
  totalScore     Decimal? @db.Decimal(8, 2)
  scoredAt       DateTime @default(now())
  scoredById     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  plan XYMEPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("xyme_scores")
}
