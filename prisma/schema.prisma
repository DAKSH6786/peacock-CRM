// Peacock One — Prisma schema
// Monetary values: store as integer minor units (e.g. cents).
// Timestamps: stored in UTC; display in organization timezone.
// Soft deletion: important business records use deletedAt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  OFFBOARDED
}

enum MembershipRole {
  SUPER_ADMIN
  ADMIN
  DEPARTMENT_HEAD
  MANAGER
  EMPLOYEE
  FINANCE
  HR
  SALES
  OPERATIONS
  CREATIVE
  VIEWER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  EXPORT
  PERMISSION_CHANGE
  LOGIN
  LOGOUT
  LOGIN_FAILED
}

// ─── Organization ────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("UTC")
  currency  String   @default("USD")
  locale    String   @default("en-US")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  users         User[]
  memberships   Membership[]
  departments   Department[]
  auditLogs     AuditLog[]
  sessions      Session[]
  accounts      Account[]

  @@index([deletedAt])
  @@map("organizations")
}

// ─── Auth.js / NextAuth models ───────────────────────────────────────────────

model User {
  id             String     @id @default(cuid())
  organizationId String?
  email          String     @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  passwordHash   String?
  status         UserStatus @default(INVITED)
  jobTitle       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id])
  memberships  Membership[]
  accounts     Account[]
  sessions     Session[]
  auditLogs    AuditLog[]    @relation("AuditActor")
  departmentId String?
  department   Department?   @relation(fields: [departmentId], references: [id])

  @@index([organizationId])
  @@index([deletedAt])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  organizationId    String?
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([organizationId])
  @@map("accounts")
}

model Session {
  id             String   @id @default(cuid())
  sessionToken   String   @unique
  userId         String
  organizationId String?
  expires        DateTime

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Membership & Departments ────────────────────────────────────────────────

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(EMPLOYEE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([deletedAt])
  @@map("memberships")
}

model Department {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  users        User[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([deletedAt])
  @@map("departments")
}

// ─── Audit ───────────────────────────────────────────────────────────────────

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  actorId        String?
  action         AuditAction
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}
